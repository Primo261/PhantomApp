<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_phantom">

        <!-- Header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="56dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <View
                android:id="@+id/slotDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_slot_dot"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSlotName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slot 1"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/phantom_text_primary"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"/>

                <TextView
                    android:id="@+id/tvFpId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="@dimen/text_micro"
                    android:textColor="@color/phantom_text_tertiary"
                    android:fontFamily="monospace"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Fingerprint chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MODEL"
                        android:textSize="9sp"
                        android:textColor="@color/phantom_text_purple_subtle"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"/>

                    <TextView
                        android:id="@+id/tvModel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SM-G991B"
                        android:textSize="10sp"
                        android:textColor="@color/phantom_text_secondary"
                        android:fontFamily="monospace"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IMEI"
                        android:textSize="9sp"
                        android:textColor="@color/phantom_text_purple_subtle"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"/>

                    <TextView
                        android:id="@+id/tvImei"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="35834923···"
                        android:textSize="10sp"
                        android:textColor="@color/phantom_text_secondary"
                        android:fontFamily="monospace"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Android ID"
                        android:textSize="9sp"
                        android:textColor="@color/phantom_text_purple_subtle"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"/>

                    <TextView
                        android:id="@+id/tvAndroidId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="a3f2b1c4···"
                        android:textSize="10sp"
                        android:textColor="@color/phantom_text_secondary"
                        android:fontFamily="monospace"/>

                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/phantom_border_subtle"/>

        <!-- Apps RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAppsInSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:overScrollMode="never"/>

    </LinearLayout>

    <!-- Delete badge overlay (top-end). 32dp tap target, red bg, ripple. -->
    <ImageView
        android:id="@+id/btn_delete_slot"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:padding="6dp"
        android:background="@drawable/bg_delete_badge_ripple"
        android:src="@drawable/ic_close"
        app:tint="@android:color/white"
        android:contentDescription="Supprimer ce slot"
        android:clickable="true"
        android:focusable="true"
        android:elevation="2dp"/>

</FrameLayout>
