<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="@dimen/spacing_lg">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_warning"
        android:tint="@color/phantom_error"
        android:layout_marginBottom="@dimen/spacing_md"
        android:contentDescription="@null"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Supprimer ce slot ?"
        android:textSize="@dimen/text_h2"
        android:textStyle="bold"
        android:textColor="@color/phantom_text_primary"
        android:fontFamily="@font/inter"
        android:gravity="center"
        tools:ignore="HardcodedText"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="Cette action est irréversible. Toutes les apps et données seront perdues."
        android:textSize="@dimen/text_body"
        android:textColor="@color/phantom_text_secondary"
        android:fontFamily="@font/inter"
        android:gravity="center"
        tools:ignore="HardcodedText"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_secondary"
            app:backgroundTint="@null"
            android:textColor="@color/phantom_text_secondary"
            android:fontFamily="@font/inter"
            android:paddingHorizontal="20dp"
            android:text="Annuler"
            android:stateListAnimator="@null"
            tools:ignore="HardcodedText"/>

        <Button
            android:id="@+id/btn_confirm"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/bg_button_destructive"
            app:backgroundTint="@null"
            android:textColor="@color/phantom_error"
            android:textStyle="bold"
            android:fontFamily="@font/inter"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:text="Supprimer"
            android:stateListAnimator="@null"
            tools:ignore="HardcodedText"/>
    </LinearLayout>
</LinearLayout>
