<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0D0B14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher"
            tools:ignore="ImageContrastCheck" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active ta license PhantomApp"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entre la license reçue via WhatsApp"
            android:textColor="#9A8FB5"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <EditText
            android:id="@+id/license_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="PHANTOM-XXXXX-XXXXX-XXXXX-XXXXX"
            android:textColorHint="#5C4F7A"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:background="#110F1D"
            android:padding="16dp"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLines="1"
            android:singleLine="true"
            android:importantForAutofill="no"
            android:layout_marginBottom="16dp"
            tools:ignore="HardcodedText,LabelFor" />

        <TextView
            android:id="@+id/error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF6B6B"
            android:textSize="14sp"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            tools:text="Format de license invalide"
            tools:visibility="visible" />

        <Button
            android:id="@+id/activate_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activer"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:padding="16dp"
            android:backgroundTint="#6C3FC7"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/loading"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#6C3FC7"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            tools:visibility="visible" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/contact_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pas de license ? Contacte-nous"
            android:textColor="#6C3FC7"
            android:textSize="14sp"
            android:padding="16dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
