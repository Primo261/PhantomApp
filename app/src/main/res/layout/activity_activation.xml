<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_activation_gradient">

    <com.phantom.app.ui.CodeRainView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="@dimen/spacing_lg">

        <View
            android:layout_width="match_parent"
            android:layout_height="60dp"/>

        <ImageView
            android:id="@+id/logo"
            android:layout_width="match_parent"
            android:layout_height="256dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:src="@drawable/logo_phantom"
            android:contentDescription="@null"
            tools:ignore="ImageContrastCheck"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_xl"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activez votre clé"
            android:textSize="@dimen/text_display"
            android:textStyle="bold"
            android:fontFamily="@font/inter"
            android:textColor="@color/phantom_text_primary"
            android:gravity="center"
            android:lineSpacingMultiplier="0.95"
            tools:ignore="HardcodedText"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Entrez votre clé d'activation pour débloquer Phantom App."
            android:textSize="@dimen/text_body"
            android:textColor="@color/phantom_text_secondary"
            android:gravity="center"
            android:fontFamily="@font/inter"
            tools:ignore="HardcodedText"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"/>

        <EditText
            android:id="@+id/license_input"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/input_phantom_state"
            android:textSize="18sp"
            android:textColor="@color/phantom_text_primary"
            android:textColorHint="@color/phantom_text_tertiary"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:hint="PHANTOM-XXXXX-XXXXX-XXXXX-XXXXX"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLines="1"
            android:singleLine="true"
            android:importantForAutofill="no"
            tools:ignore="HardcodedText,LabelFor"/>

        <TextView
            android:id="@+id/error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/phantom_error"
            android:textSize="@dimen/text_caption"
            android:fontFamily="@font/inter"
            android:visibility="gone"
            android:layout_marginTop="@dimen/spacing_sm"
            tools:text="Format de license invalide"
            tools:visibility="visible"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_md"/>

        <Button
            android:id="@+id/activate_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_primary"
            app:backgroundTint="@null"
            android:textColor="@color/phantom_text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:fontFamily="@font/inter"
            android:text="Activer ma licence"
            android:elevation="8dp"
            android:stateListAnimator="@null"
            tools:ignore="HardcodedText"/>

        <ProgressBar
            android:id="@+id/loading"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/phantom_accent"
            android:visibility="gone"
            android:layout_marginTop="@dimen/spacing_md"
            tools:visibility="visible"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/spacing_xl"/>

        <TextView
            android:id="@+id/contact_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Besoin d'aide ? Contactez le support"
            android:textColor="@color/phantom_accent_bright"
            android:textSize="@dimen/text_caption"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:padding="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_lg"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            tools:ignore="HardcodedText,UnusedAttribute"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phantom App by PLZ · v1.0.1 · BETA"
            android:textColor="@color/phantom_text_tertiary"
            android:textSize="@dimen/text_micro"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginBottom="@dimen/spacing_lg"
            tools:ignore="HardcodedText"/>

    </LinearLayout>
    </ScrollView>

</FrameLayout>
