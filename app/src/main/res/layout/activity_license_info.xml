<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/phantom_bg_primary">

    <!-- Custom toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_md"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="@dimen/spacing_xs"
            android:src="@drawable/ic_back_arrow"
            android:tint="@color/phantom_text_primary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Retour"
            tools:ignore="HardcodedText,UnusedAttribute"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="32dp"
            android:text="Ma Licence"
            android:textSize="@dimen/text_h1"
            android:textStyle="bold"
            android:textColor="@color/phantom_text_primary"
            android:fontFamily="@font/inter"
            android:gravity="center"
            tools:ignore="HardcodedText"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:overScrollMode="never"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Status card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_phantom"
                android:padding="@dimen/spacing_lg">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_check_circle"
                    android:tint="@color/phantom_success"
                    android:contentDescription="@null"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="Licence active"
                    android:textSize="@dimen/text_h2"
                    android:textStyle="bold"
                    android:textColor="@color/phantom_text_primary"
                    android:fontFamily="@font/inter"
                    tools:ignore="HardcodedText"/>

                <TextView
                    android:id="@+id/tv_activated_at"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/phantom_text_secondary"
                    android:fontFamily="@font/inter"
                    tools:text="Activée le 20/05/2026"/>
            </LinearLayout>

            <!-- Details card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_phantom"
                android:padding="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LABEL"
                    android:textSize="@dimen/text_micro"
                    android:textColor="@color/phantom_text_purple_subtle"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/inter"
                    tools:ignore="HardcodedText"/>

                <TextView
                    android:id="@+id/tv_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/phantom_text_primary"
                    android:fontFamily="@font/inter"
                    tools:text="SUPER ADMIN"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/phantom_border_subtle"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:layout_marginBottom="@dimen/spacing_md"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXPIRATION"
                    android:textSize="@dimen/text_micro"
                    android:textColor="@color/phantom_text_purple_subtle"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/inter"
                    tools:ignore="HardcodedText"/>

                <TextView
                    android:id="@+id/tv_expiration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/phantom_text_primary"
                    android:fontFamily="@font/inter"
                    tools:text="20/05/2027"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/phantom_border_subtle"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:layout_marginBottom="@dimen/spacing_md"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEVICE ID"
                    android:textSize="@dimen/text_micro"
                    android:textColor="@color/phantom_text_purple_subtle"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/inter"
                    tools:ignore="HardcodedText"/>

                <TextView
                    android:id="@+id/tv_device_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/phantom_text_secondary"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    tools:text="b15d4a2b-90fe-4c9f-9123-1a2b3c4d5e6f"/>
            </LinearLayout>

            <!-- Actions card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_phantom"
                android:padding="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_xl">

                <Button
                    android:id="@+id/btn_deactivate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_button_destructive"
                    app:backgroundTint="@null"
                    android:textColor="@color/phantom_error"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter"
                    android:text="Désactiver et changer de clé"
                    android:stateListAnimator="@null"
                    tools:ignore="HardcodedText"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
