<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingTop="12dp"
    android:paddingBottom="@dimen/spacing_xl">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_lg"/>

    <TextView
        android:id="@+id/sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg"
        android:text="Actions"
        android:textSize="@dimen/text_h2"
        android:textStyle="bold"
        android:textColor="@color/phantom_text_primary"
        android:fontFamily="@font/inter"
        tools:ignore="HardcodedText"/>

    <LinearLayout
        android:id="@+id/action_rename"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_edit"
            android:tint="@color/phantom_accent_bright"
            android:contentDescription="@null"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_md"
            android:text="Renommer le slot"
            android:textColor="@color/phantom_text_primary"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/inter"
            tools:ignore="HardcodedText"/>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/phantom_text_tertiary"
            android:contentDescription="@null"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:background="@color/phantom_border_subtle"/>

    <LinearLayout
        android:id="@+id/action_delete"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_trash"
            android:tint="@color/phantom_error"
            android:contentDescription="@null"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_md"
            android:text="Supprimer le slot"
            android:textColor="@color/phantom_error"
            android:textStyle="bold"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/inter"
            tools:ignore="HardcodedText"/>
    </LinearLayout>
</LinearLayout>
